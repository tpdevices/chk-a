# chk-a environment file (/etc/chk-a/env)
# Sourced by systemd via EnvironmentFile=. Secrets are NOT committed.
#
# Telegram credentials (required for alerts to fire).
# Get a bot token from @BotFather and the chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Path to the runtime configuration file.
CHK_A_CONFIG=/etc/chk-a/config.yaml

# Optional: HTTP /healthz port (0 disables).
CHK_A_HEALTH_PORT=0

# Optional: seconds between systemd WATCHDOG pings (0 disables).
# Must be < WatchdogSec (60). Default 30.
CHK_A_WATCHDOG_INTERVAL=30
